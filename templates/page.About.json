    "1758791355730399080e": {
      "type": "custom-html",
      "settings": {
        "color_scheme": "scheme-3",
        "html": "\u003clink rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\"\u003e\r\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"\u003e\u003c/script\u003e\r\n\r\n\u003cdiv class=\"mudjean-swiper\"\u003e\r\n    \u003cdiv class=\"swiper-wrapper\"\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(1).jpg\" alt=\"Mudjean Factory Image 1\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(2).jpg\" alt=\"Mudjean Factory Image 2\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(3).jpg\" alt=\"Mudjean Factory Image 3\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(4).jpg\" alt=\"Mudjean Factory Image 4\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(5).jpg\" alt=\"Mudjean Factory Image 5\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(6).jpg\" alt=\"Mudjean Factory Image 6\"\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"mudjean-swiper-pagination\"\u003e\u003c/div\u003e\r\n\u003c/div\u003e\r\n\u003cscript\u003e\r\n    // 确保在页面加载完毕后执行\r\n    document.addEventListener('DOMContentLoaded', function () {\r\n        const swiper = new Swiper('.mudjean-swiper', {\r\n            pagination: {\r\n                // 使用我们自定义的、唯一的类名\r\n                el: \".mudjean-swiper-pagination\", \r\n                clickable: true,\r\n                renderBullet: function (index, className) {\r\n                    // className 依然是 Swiper 默认的 'swiper-pagination-bullet'\r\n                    return '\u003cspan class=\"' + className + '\"\u003e' + (index + 1) + \"\u003c/span\u003e\";\r\n                },\r\n            },\r\n        });\r\n    });\r\n\u003c/script\u003e",
