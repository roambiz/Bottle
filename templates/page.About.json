    "1758791355730399080e": {
      "type": "custom-html",
      "settings": {
        "color_scheme": "scheme-3",
        "html": "\u003clink rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\"\u003e\r\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"\u003e\u003c/script\u003e\r\n\r\n\u003cdiv class=\"mudjean-carousel-container\"\u003e\r\n    \u003cdiv class=\"mudjean-carousel-wrapper\"\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(1).jpg\" alt=\"Mudjean Factory Image 1\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(2).jpg\" alt=\"Mudjean Factory Image 2\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(3).jpg\" alt=\"Mudjean Factory Image 3\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(4).jpg\" alt=\"Mudjean Factory Image 4\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(5).jpg\" alt=\"Mudjean Factory Image 5\"\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"mudjean-carousel-slide\"\u003e\r\n            \u003cimg src=\"https://img-va.myshopline.com/image/store/1754883979727/mudjean-factory-1-(6).jpg\" alt=\"Mudjean Factory Image 6\"\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"mudjean-carousel-pagination\"\u003e\u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n\u003cstyle\u003e\r\n    /* 容器：确保它占据可用宽度 */\r\n    .mudjean-carousel-container {\r\n        width: 100%;\r\n        max-width: 900px;\r\n        /* 可选：限制最大宽度 */\r\n        margin: 0 auto;\r\n        /* 居中显示 */\r\n    }\r\n\r\n    /* 单张幻灯片：确保内容居中 */\r\n    .mudjean-carousel-slide {\r\n        display: flex;\r\n        justify-content: center;\r\n        align-items: center;\r\n        background: #eee;\r\n        /* 添加浅灰色背景以防图片加载慢 */\r\n    }\r\n\r\n    /* 图片：核心规则，确保响应式且不变形 */\r\n    .mudjean-carousel-slide img {\r\n        display: block;\r\n        width: 100%;\r\n        height: auto;\r\n        /* 高度自适应 */\r\n        object-fit: contain;\r\n        /* 确保整张图片可见，可能会有留白 */\r\n    }\r\n\r\n    /* 分页器：简化样式，仅保留功能性 */\r\n    .mudjean-carousel-pagination {\r\n        text-align: center;\r\n        padding-top: 10px;\r\n        /* 与轮播图保持一点距离 */\r\n    }\r\n\r\n    .mudjean-carousel-bullet {\r\n        display: inline-block;\r\n        width: 20px;\r\n        height: 20px;\r\n        line-height: 20px;\r\n        font-size: 12px;\r\n        color: #000;\r\n        background: #ccc;\r\n        border-radius: 50%;\r\n        margin: 0 4px;\r\n        cursor: pointer;\r\n    }\r\n\r\n    .mudjean-carousel-bullet-active {\r\n        background: #007aff;\r\n        color: #fff;\r\n    }\r\n\u003c/style\u003e\r\n\r\n\u003cscript\u003e\r\n    const swiper = new Swiper('.mudjean-carousel-container', {\r\n        wrapperClass: 'mudjean-carousel-wrapper',\r\n        slideClass: 'mudjean-carousel-slide',\r\n        \r\n        pagination: {\r\n            el: \".mudjean-carousel-pagination\",\r\n            clickable: true,\r\n            bulletClass: 'mudjean-carousel-bullet',\r\n            bulletActiveClass: 'mudjean-carousel-bullet-active',\r\n            renderBullet: function (index, className) {\r\n                return '\u003cspan class=\"' + className + '\"\u003e' + (index + 1) + '\u003c/span\u003e';\r\n            },\r\n        },\r\n    });\r\n\u003c/script\u003e",
        "layout": {
