              "type": "heading",
              "settings": {
                "text": "Secure Payments Processed by PayPal",
                "text_align": "left",
                "text_size": "title4"
              },
              "blocks": {},
              "block_order": []
            },
            "17575742954620848370": {
              "type": "rich-text",
              "settings": {
                "content": "\u003cp dir=\"auto\"\u003eWe prioritize your security and convenience. We have streamlined our checkout process to ensure your payment is safe, secure, and simple. All of our online transactions are securely processed through PayPal, a leading payment gateway known for its robust encryption and data protection. This ensures that your financial details are handled safely at all times. You can shop with confidence knowing your data is protected.\u003c/p\u003e",
                "size": {
                  "height": "auto",
                  "width": "100%"
                },
                "spacing": {
                  "padding-bottom": "0px",
                  "padding-left": "0px",
                  "padding-right": "0px",
                  "padding-top": "0px"
                },
                "text_align": "left"
              },
              "blocks": {},
              "block_order": []
            }
          },
          "block_order": [
