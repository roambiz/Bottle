            "1757574386618aff940d": {
              "type": "rich-text",
              "settings": {
                "content": "\u003cp dir=\"auto\"\u003eWhile PayPal is our payment processor, you do not need a PayPal account to complete your purchase. We accept all major credit and debit cards through the PayPal gateway, with no additional transaction fees from our side.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eSimply select the 'Pay with Debit or Credit Card' option on the PayPal checkout page. We proudly accept the following cards:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003ePayPal\u003c/li\u003e\n\u003cli\u003eAmerican Express\u003c/li\u003e\n\u003cli\u003eDiners Club\u003c/li\u003e\n\u003cli\u003eDiscover\u003c/li\u003e\n\u003cli\u003eMasterCard\u003c/li\u003e\n\u003cli\u003eVISA\u003c/li\u003e\n\u003c/ul\u003e",
                "size": {
                  "height": "auto",
                  "width": "100%"
                },
                "spacing": {
                  "padding-bottom": "0px",
                  "padding-left": "0px",
                  "padding-right": "0px",
                  "padding-top": "0px"
                },
                "text_align": "left"
              },
              "blocks": {},
              "block_order": []
            },
            "1757574386618b0497b7": {
              "type": "heading",
              "settings": {
                "text": "Pay with Your Preferred Card — No PayPal Account Needed",
                "text_align": "left",
                "text_size": "title4"
              },
              "blocks": {},
              "block_order": []
            }
          },
          "block_order": [
